<%
  /* Variables : page {title, meta, url}, baseUrl,
     actif (accueil|missions|adopter|famille|soutenir|conseils|contact),
     fil [{nom, url}] (facultatif), ld [objets JSON-LD] (facultatif), robots (facultatif). */
  const _base = String(locals.baseUrl || '').replace(/\/$/, '');
  const _canon = _base + page.url;
  const _asso = locals.association || {};
  const _reseaux = (_asso.reseaux || []).filter(function (r) { return r.url; });
  const _org = {
    '@context': 'https://schema.org',
    '@type': 'NGO',
    name: _asso.nom || 'Les Petits Oubliés',
    url: _base + '/',
    description: _asso.baseline || ''
  };
  if (_asso.email) _org.email = _asso.email;
  if (_asso.telephone_e164) _org.telephone = _asso.telephone_e164;
  if (_reseaux.length) _org.sameAs = _reseaux.map(function (r) { return r.url; });
  const _ld = [_org].concat(locals.ld || []);
  if (locals.fil && locals.fil.length) {
    _ld.push({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: locals.fil.map((e, i) => ({
        '@type': 'ListItem', position: i + 1, name: e.nom, item: _base + e.url
      }))
    });
  }
  const _nav = [
    { cle: 'accueil', nom: 'Accueil', url: '/' },
    { cle: 'missions', nom: 'Nos missions', url: '/nos-missions' },
    { cle: 'adopter', nom: 'Adopter', url: '/adopter' },
    { cle: 'famille', nom: 'Famille d’accueil', url: '/famille-accueil' },
    { cle: 'soutenir', nom: 'Nous soutenir', url: '/nous-soutenir' },
    { cle: 'conseils', nom: 'Conseils', url: '/conseils' },
    { cle: 'contact', nom: 'Contact', url: '/contact' }
  ];
%><!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title %></title>
  <meta name="description" content="<%= page.meta %>">
  <meta name="robots" content="<%= locals.robots || 'index, follow' %>">
  <link rel="canonical" href="<%= _canon %>">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="Les Petits Oubliés">
  <meta property="og:title" content="<%= page.title %>">
  <meta property="og:description" content="<%= page.meta %>">
  <meta property="og:url" content="<%= _canon %>">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/main.js" defer></script>
<% if (locals.scripts) { locals.scripts.forEach(function (src) { %>  <script src="<%= src %>" defer></script>
<% }); } %><% _ld.forEach(function (o) { %>  <script type="application/ld+json"><%- JSON.stringify(o).replace(/</g, '\\u003c') %></script>
<% }); %></head>
<body>
  <a class="evitement" href="#contenu">Aller au contenu</a>
  <header class="entete">
    <div class="entete-interieur">
      <div class="entete-barre">
        <a class="marque" href="/">
          <img src="/img/marque/logo.svg" alt="<%= (_asso.nom || 'Les Petits Oubliés') + ', association de protection animale' %>" width="320" height="56">
        </a>
        <button type="button" class="bouton-menu" hidden aria-expanded="false" aria-controls="menu-principal">Menu</button>
      </div>
      <nav class="nav" data-menu aria-label="Navigation principale">
        <ul id="menu-principal">
<% _nav.forEach(function (n) { %>          <li><a href="<%= n.url %>"<% if (locals.actif === n.cle) { %> aria-current="page"<% } %>><%= n.nom %></a></li>
<% }); %>        </ul>
      </nav>
    </div>
  </header>
  <main id="contenu" class="principal" tabindex="-1">
<% if (locals.fil && locals.fil.length) { %>    <nav class="fil-ariane" aria-label="Fil d'Ariane">
      <ol>
<% locals.fil.forEach(function (e, i) { %>        <li><% if (i < locals.fil.length - 1) { %><a href="<%= e.url %>"><%= e.nom %></a><% } else { %><span aria-current="page"><%= e.nom %></span><% } %></li>
<% }); %>      </ol>
    </nav>
<% } %>
