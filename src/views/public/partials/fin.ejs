  </main>
<%
  const _a = locals.association || {};
  const _res = (_a.reseaux || []).filter(function (r) { return r.url; });
%>  <footer class="pied">
    <div class="pied-interieur">
      <nav aria-label="Informations légales">
        <ul>
          <li><a href="/nous-soutenir">Nous soutenir</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/mentions-legales">Mentions légales</a></li>
          <li><a href="/confidentialite">Politique de confidentialité</a></li>
<% if (locals.statique) { /* Export GitHub Pages seulement : la connexion y est inerte. Le serveur Node ne lie jamais /interne. */ %>          <li><a href="/interne/atelier" rel="nofollow">Espace interne (démo réseaux)</a></li>
<% } %>        </ul>
      </nav>
<% if (_res.length) { %>      <ul class="liste-reseaux">
<% _res.forEach(function (r) { %>        <li><a href="<%= r.url %>" rel="noopener noreferrer"><%= r.nom %></a></li>
<% }); %>      </ul>
<% } %>      <p><%= _a.nom || 'Les Petits Oubliés' %><% if (_a.telephone) { %> — <%= _a.telephone %><% } %><% if (_a.email) { %> — <%= _a.email %><% } %></p>
      <p>Aucun paiement et aucune adoption ne sont conclus en ligne : chaque demande donne lieu à un échange avec l’équipe.</p>
