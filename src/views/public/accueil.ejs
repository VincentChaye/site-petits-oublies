<%
  /* Variables : page (pages.accueil), baseUrl, vedettes (animaux disponibles, 0 à 4). */
  const _ld = [{
    '@context': 'https://schema.org',
    '@type': 'AnimalShelter',
    name: 'Refuge des Quatre Vents (site de démonstration)',
    url: baseUrl.replace(/\/$/, '') + '/',
    description: page.meta
  }];
%><%- include('partials/debut', { actif: 'accueil', ld: _ld }) %>
    <div class="heros">
      <h1><%= page.h1 %></h1>
      <p class="intro"><%= page.intro %></p>
      <p><a class="bouton" href="/animaux">Voir les animaux</a></p>
    </div>
<% if (locals.vedettes && vedettes.length) { %>    <section aria-labelledby="titre-vedettes">
      <h2 id="titre-vedettes">Ils attendent une famille</h2>
      <ul class="liste-animaux">
<% vedettes.forEach(function (a) { %><%- include('partials/carte-animal', { a: a, niveau: 3 }) %><% }); %>      </ul>
    </section>
<% } %>    <div class="sections-accueil">
<% page.sections.forEach(function (s) { %>      <section>
        <h2><%= s.h2 %></h2>
        <p><%= s.texte %></p>
        <p><a class="bouton bouton-secondaire" href="<%= s.cta.url %>"><%= s.cta.libelle %></a></p>
      </section>
<% }); %>    </div>
<%- include('partials/fin') %>
