<%
  /* Variables : animal, formulaires (content/formulaires.json), etat {valeurs, erreurs, envoye, erreurGenerale},
     formToken, baseUrl, csrfToken (facultatif).
     Route POST : /animaux/:slug/interet. */
  const _def = formulaires.interet;
  const _url = '/animaux/' + animal.slug;
  const _page = {
    title: 'Projet d’adoption pour ' + animal.nom + ' – Les Petits Oubliés',
    meta: 'Parlez-nous de votre projet d’adoption pour ' + animal.nom + ' : un membre de l’équipe des Petits Oubliés vous recontacte. Aucun engagement.',
    url: _url + '/interet'
  };
  const _fil = [{ nom: 'Accueil', url: '/' }, { nom: 'Adopter', url: '/adopter' }, { nom: animal.nom, url: _url }, { nom: 'Projet d’adoption', url: _url + '/interet' }];
  const _champs = [
    { nom: 'prenom', type: 'text', autocomplete: 'given-name' },
    { nom: 'email', type: 'email', autocomplete: 'email' },
    { nom: 'telephone', type: 'tel', autocomplete: 'tel' },
    { nom: 'logement', type: 'textarea', rows: 3 },
    { nom: 'message', type: 'textarea', rows: 5 },
    { nom: 'consentement', type: 'checkbox' }
  ];
%><%- include('partials/debut', { page: _page, actif: 'adopter', fil: _fil, robots: 'noindex, follow' }) %>
    <h1>Mon projet d’adoption : <%= animal.nom %></h1>
    <p><a class="lien-bloc" href="<%= _url %>">Retour à la fiche de <%= animal.nom %></a></p>
<% if (animal.statut === 'en_soins') { %>    <p class="alerte" role="note"><%= animal.nom %> est encore en soins : votre demande est la bienvenue dès maintenant, et nous vous préviendrons dès qu’une adoption sera possible.</p>
<% } %>
<%- include('partials/formulaire', { id: 'formulaire-interet', def: _def, titre: _def.titre.replace('{nom}', animal.nom), action: _url + '/interet', champs: _champs, etat: locals.etat, niveau: 2 }) %>
<%- include('partials/fin') %>
