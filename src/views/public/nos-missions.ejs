<%
  /* Variables : page (pages.nos_missions), baseUrl, association. */
  const _fil = [{ nom: 'Accueil', url: '/' }, { nom: 'Nos missions', url: page.url }];
%><%- include('partials/debut', { actif: 'missions', fil: _fil, ld: [{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: page.h1,
    description: page.meta,
    url: baseUrl.replace(/\/$/, '') + page.url
  }] }) %>
    <h1><%= page.h1 %></h1>
    <p class="intro"><%= page.intro %></p>
<% page.sections.forEach(function (s, i) { %>    <section class="bande<%= i % 2 ? ' bande-verte' : '' %>" id="<%= s.id %>">
      <h2><%= s.h2 %></h2>
      <p><%= s.texte %></p>
<% if (s.points && s.points.length) { %>      <ul class="liste-puces">
<% s.points.forEach(function (p) { %>        <li><%= p %></li>
<% }); %>      </ul>
<% } %><% if (s.cta) { %>      <p><a class="bouton" href="<%= s.cta.url %>"><%= s.cta.libelle %></a></p>
<% } %>    </section>
<% }); %><% if (page.flyer && page.flyer.url) { %>    <section class="section">
      <h2>Notre flyer</h2>
      <p><%= page.flyer.texte %></p>
      <p><a class="bouton bouton-secondaire" href="<%= page.flyer.url %>"><%= page.flyer.libelle %></a></p>
    </section>
<% } %>    <section class="section">
      <h2>Agir avec nous</h2>
      <p class="actions">
        <a class="bouton" href="/adopter">Adopter un animal</a>
        <a class="bouton bouton-secondaire" href="/famille-accueil">Devenir famille d’accueil</a>
        <a class="bouton bouton-secondaire" href="/nous-soutenir">Nous soutenir</a>
      </p>
    </section>
<%- include('partials/fin') %>
