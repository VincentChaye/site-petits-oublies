<%
  /* Route : GET /interne/connexion (affichage), POST /interne/connexion (champ « secret »).
     Variables : erreur (string|null), csrfToken (facultatif). */
%><%- include('partials/debut', { titre: 'Connexion', sansMenu: true }) %>
    <h1>Connexion à l’espace interne</h1>
    <p class="intro">Saisissez le secret partagé de l’équipe. Un cookie de session est déposé uniquement sur l’espace interne.</p>
<% if (locals.erreur) { %>    <div class="resume-erreurs" role="alert" tabindex="-1" data-focus-initial>
      <p><%= erreur %></p>
    </div>
<% } %>    <form class="formulaire" method="post" action="/interne/connexion">
<% if (locals.csrfToken) { %>      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% } %>      <div class="champ<%= locals.erreur ? ' champ-erreur' : '' %>">
        <label for="secret">Secret</label>
        <input type="password" id="secret" name="secret" autocomplete="current-password" required<% if (locals.erreur) { %> aria-invalid="true" aria-describedby="secret-erreur"<% } %>>
<% if (locals.erreur) { %>        <p class="erreur" id="secret-erreur"><%= erreur %></p>
<% } %>      </div>
      <button type="submit" class="bouton">Se connecter</button>
    </form>
<%- include('partials/fin') %>
