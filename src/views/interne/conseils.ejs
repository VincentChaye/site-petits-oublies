<%
  /* Route : GET /interne/conseils. Variables : conseils [{slug, titre, sections, outil, version}], csrfToken, message. */
%><%- include('partials/debut', { titre: 'Fiches conseils', ecran: 'conseils' }) %>
    <h1>Fiches conseils</h1>
    <p>Ces fiches alimentent la page publique <a href="/conseils">Conseils</a>. Une fiche créée ici apparaît aussitôt sur le site, sans redémarrage.</p>
    <p><a class="bouton" href="/interne/conseils/nouveau">Créer une fiche</a></p>
<% if (!conseils.length) { %>    <div class="etat-vide">
      <p>Aucune fiche pour le moment.</p>
    </div>
<% } else { %>    <div class="tableau-defilant" role="region" aria-label="Fiches conseils existantes" tabindex="0">
      <table class="tableau">
        <caption class="contenu-cache">Fiches conseils existantes</caption>
        <thead>
          <tr><th scope="col">Titre</th><th scope="col">Identifiant</th><th scope="col">Sections</th><th scope="col">Outil</th><th scope="col">Actions</th></tr>
        </thead>
        <tbody>
<% conseils.forEach(function (c) { %>          <tr>
            <th scope="row" data-label="Titre"><%= c.titre %></th>
            <td data-label="Identifiant"><%= c.slug %></td>
            <td data-label="Sections"><%= c.sections %></td>
            <td data-label="Outil"><%= c.outil %></td>
            <td data-label="Actions" class="cellule-actions">
              <a href="/conseils/<%= encodeURIComponent(c.slug) %>">Voir<span class="contenu-cache"> la fiche publique <%= c.titre %></span></a>
              <a href="/interne/conseils/<%= encodeURIComponent(c.slug) %>/modifier">Modifier<span class="contenu-cache"> la fiche <%= c.titre %></span></a>
              <form method="post" action="/interne/conseils/<%= encodeURIComponent(c.slug) %>/supprimer">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="_version" value="<%= c.version %>">
                <button type="submit" class="bouton bouton-danger">Supprimer<span class="contenu-cache"> la fiche <%= c.titre %></span></button>
              </form>
            </td>
          </tr>
<% }); %>        </tbody>
      </table>
    </div>
<% } %><%- include('partials/fin') %>
