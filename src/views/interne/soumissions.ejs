<%
  /* Routes : GET /interne/soumissions?type=<cle> ; GET /interne/soumissions/export.csv?type=<cle> (téléchargement).
     Variables : types [{cle: 'interet'|'contact'|'benevolat'|'don_parrainage', libelle, total}],
       type (cle active), colonnes [{cle, libelle}], soumissions [{id, createdAt, valeurs: {cle: texte}}]
       du plus récent au plus ancien. csrfToken, message (facultatifs). */
  const _dt = function (iso) { return new Date(iso).toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short', timeZone: 'Europe/Paris' }); };
  const _actif = types.find(function (t) { return t.cle === type; }) || types[0];
%><%- include('partials/debut', { titre: 'Soumissions', ecran: 'soumissions' }) %>
    <h1>Soumissions des formulaires</h1>
    <nav class="onglets" aria-label="Type de formulaire">
      <ul>
<% types.forEach(function (t) { %>        <li><a href="/interne/soumissions?type=<%= t.cle %>"<% if (t.cle === _actif.cle) { %> aria-current="page"<% } %>><%= t.libelle %> (<%= t.total %>)</a></li>
<% }); %>      </ul>
    </nav>
    <h2><%= _actif.libelle %></h2>
    <form class="formulaire" method="get" action="/interne/soumissions">
      <input type="hidden" name="type" value="<%= _actif.cle %>">
      <div class="champ">
        <label for="filtre-statut">Filtrer par statut</label>
        <select id="filtre-statut" name="statut">
          <option value="">Tous</option>
<% statuts.forEach(function (st) { %>          <option value="<%= st.cle %>"<% if (st.cle === filtre) { %> selected<% } %>><%= st.libelle %></option>
<% }); %>        </select>
      </div>
      <button type="submit" class="bouton bouton-secondaire">Filtrer</button>
    </form>
    <p><a class="bouton bouton-secondaire" href="/interne/soumissions/export.csv?type=<%= _actif.cle %>" download>Exporter en CSV</a></p>
<% if (soumissions.length === 0) { %>    <p class="etat-vide">Aucune soumission pour ce formulaire.</p>
<% } else { %>    <div class="tableau-defilant" role="region" aria-label="Soumissions : <%= _actif.libelle %>" tabindex="0">
      <table class="tableau">
        <caption class="contenu-cache">Soumissions du formulaire « <%= _actif.libelle %> », les plus récentes d’abord</caption>
        <thead>
          <tr>
            <th scope="col">Reçue le</th>
<% colonnes.forEach(function (c) { %>            <th scope="col"><%= c.libelle %></th>
<% }); %>            <th scope="col">Suivi</th>
          </tr>
        </thead>
        <tbody>
<% soumissions.forEach(function (s) { %>          <tr>
            <th scope="row" data-label="Reçue le"><time datetime="<%= s.createdAt %>"><%= _dt(s.createdAt) %></time></th>
<% colonnes.forEach(function (c) { %>            <td data-label="<%= c.libelle %>"><%= s.valeurs[c.cle] == null ? '' : s.valeurs[c.cle] %></td>
<% }); %>            <td id="soumission-<%= s.id %>" data-label="Suivi">
              <form method="post" action="/interne/soumissions/<%= encodeURIComponent(s.id) %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="filtre" value="<%= filtre %>">
                <div class="champ">
                  <label for="statut-<%= s.id %>">Statut</label>
                  <select id="statut-<%= s.id %>" name="statut">
<% statuts.forEach(function (st) { %>                    <option value="<%= st.cle %>"<% if (st.cle === s.statut) { %> selected<% } %>><%= st.libelle %></option>
<% }); %>                  </select>
                </div>
                <div class="champ">
                  <label for="note-<%= s.id %>">Note (<%= noteMax %> caractères maximum)</label>
                  <textarea id="note-<%= s.id %>" name="note" rows="3" maxlength="<%= noteMax %>"><%= s.note %></textarea>
                </div>
                <p>Modifiée le <time datetime="<%= s.modifieLe %>"><%= _dt(s.modifieLe) %></time></p>
                <button type="submit" class="bouton bouton-secondaire">Enregistrer</button>
              </form>
            </td>
          </tr>
<% }); %>        </tbody>
      </table>
    </div>
<% } %><%- include('partials/fin') %>
