# Configuration locale du site de l'association Les Petits Oubliés.
# Copiez ce fichier : cp .env.example .env  (le .env n'est jamais suivi par git)

# ── Obligatoire ───────────────────────────────────────────────────────────────
# Secret de l'espace interne (/interne) : 32 caractères minimum.
# Générez le vôtre : openssl rand -hex 32
INTERNAL_SECRET=CHANGEZ-MOI-remplacez-par-openssl-rand-hex-32

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Dossier des données générées (soumissions, compteurs de vues, posts simulés).
DATA_DIR=data
# URL publique du site, utilisée pour les liens canoniques et le sitemap.
BASE_URL=http://localhost:3000

# ── Tableau de bord ───────────────────────────────────────────────────────────
# Seuil de consultations en dessous duquel une fiche est signalée « à surveiller »
# et déclenche une proposition de relance sociale.
ATTENTION_THRESHOLD=5

# ── Communication sociale (simulation uniquement) ─────────────────────────────
# Aucune publication réelle n'est effectuée : le mode « reel » n'est pas implémenté.
SOCIAL_MODE=simulation
SOCIAL_SITE_URL=http://localhost:3000

SOCIAL_FACEBOOK_ENABLED=true
SOCIAL_INSTAGRAM_ENABLED=true
SOCIAL_X_ENABLED=true
SOCIAL_LINKEDIN_ENABLED=true

# Clés factices : suffisent à la simulation, aucune API n'est appelée.
SOCIAL_FACEBOOK_API_KEY=cle-de-demonstration
SOCIAL_INSTAGRAM_API_KEY=cle-de-demonstration
SOCIAL_X_API_KEY=cle-de-demonstration
SOCIAL_LINKEDIN_API_KEY=cle-de-demonstration

# Plateforme dont l'envoi échoue volontairement (pour vérifier les reprises) : facebook|instagram|x|linkedin
SOCIAL_SIMULATE_FAILURE=
SOCIAL_NEW_ARRIVAL_DAYS=14
SOCIAL_RELANCE_PERIOD_DAYS=30
SOCIAL_RETRY_BASE_MS=60000
